{
  "name": "docpilot-console-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:host": "node ../node_modules/esbuild/bin/esbuild src/host-client.tsx --bundle --format=esm --platform=browser --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=host/app.js",
    "build": "tsc -p tsconfig.build.json && node ../node_modules/esbuild/bin/esbuild src/host-client.tsx --bundle --format=esm --platform=browser --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=host/app.js",
    "start": "node dist/main.js",
    "serve": "node dist/server.js",
    "test": "pnpm build && node tests/core.test.mjs && node tests/integration.test.mjs && node tests/react.test.mjs && node tests/server.test.mjs && node tests/provider-stream.test.mjs && node tests/answer-stream.test.mjs && node tests/real-http-stream.test.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.9",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "0.44.7",
    "hono": "4.9.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sql.js": "1.13.0"
  }
}
